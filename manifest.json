{
  "manifest_version": 3,
  "name": "SECAF-PRO",
  "description": "Calcula horas presenciais no sistema SECAF (IBGE). Não oficial.",
  "version": "1.0.1",
  "action": {
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    },
    "default_title": "SECAF-PRO"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "images/icon16.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  }
}
